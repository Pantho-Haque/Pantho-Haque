{
  "name": "pantho-haque-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "docker": "docker compose up --build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "vercel:link": "vercel link",
    "env:pull": "vercel env pull .env.vercel",
    "content:pull": "node --env-file=.env.local scripts/content-pull.ts",
    "revalidate": "node --env-file=.env.local scripts/revalidate.ts",
    "deploy:preview": "vercel deploy",
    "ship": "pnpm check && vercel deploy --prod",
    "prepare": "husky"
  },
  "dependencies": {
    "@pantho075/trackima": "0.1.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "typescript": "^5",
    "vercel": "^65.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
