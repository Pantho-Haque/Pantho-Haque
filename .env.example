# Portfolio env. Set these in Vercel → Project → Settings → Environment Variables, then `pnpm env:pull`.
# Without SUPABASE_* the site serves content.fallback.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Same value as REVALIDATE_SECRET in Domino (openssl rand -hex 32)
REVALIDATE_SECRET=
# Site URLs (required; no defaults in code)
NEXT_PUBLIC_SITE_URL=https://panthohaque.vercel.app
# Optional: your Trackima site id for this domain
NEXT_PUBLIC_TRACKIMA_SITE=
